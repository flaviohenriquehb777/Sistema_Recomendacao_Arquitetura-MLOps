# =============================================================================
# Variáveis de ambiente do projeto — Sistema de Recomendação (Sam's Club)
# -----------------------------------------------------------------------------
# Como usar:
#   1. Copie este arquivo para ".env":   cp .env.example .env
#   2. Preencha os valores reais.
# O ".env" é ignorado pelo Git (ver .gitignore) e NUNCA deve ser commitado.
# =============================================================================

# Token pessoal do DagsHub (Account Settings > Tokens).
# Usado para autenticar NESTE repositório (DVC e MLflow).
DAGSHUB_USER_TOKEN=seu_token_dagshub

# Dono e nome do repositório do DagsHub DESTE projeto.
DAGSHUB_REPO_OWNER=flaviohenriquehb777
DAGSHUB_REPO_NAME=Sistema_Recomendacao_Arquitetura-MLOps

# Nome do experimento MLflow deste projeto.
RECOMENDACAO_MLFLOW_EXPERIMENT=recomendacao_produtos

# URI de tracking do MLflow (específica DESTE projeto).
# Deixe comentada para usar o backend LOCAL em SQLite (sqlite:///<raiz>/mlflow.db),
# que roda 100% offline e é o padrão do pipeline (backend recomendado pelo MLflow 3).
# Descomente a linha abaixo para registrar os experimentos no DagsHub (usa o
# DAGSHUB_USER_TOKEN acima para autenticar).
# RECOMENDACAO_MLFLOW_TRACKING_URI=https://dagshub.com/flaviohenriquehb777/Sistema_Recomendacao_Arquitetura-MLOps.mlflow
